# Cloudflare Pages _headers file — MauTravel
# IMPORTANT: Replace https://www.mautravel.com with your actual domain before deployment.
# This file must be in the root of the build output directory.
# For Next.js static export: place in /public (it will be copied to /out automatically).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/ai.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/activities/*
  Cache-Control: public, max-age=2592000

/car-rental/*
  Cache-Control: public, max-age=2592000

/airport-pickup-cars/*
  Cache-Control: public, max-age=2592000
